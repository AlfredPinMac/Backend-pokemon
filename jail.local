[DEFAULT]
banaction = iptables-allports
ignoreip  = 127.0.0.1/8
usedns    = no
backend   = polling

# Escalate repeated bans for repeat offenders
bantime = 10m
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1d
bantime.rndtime = 30s

[sshd]
enabled = false

[sshd-ddos]
enabled = false

[http-flood]
enabled  = true
port     = 5000,http,https
filter   = http-flood
logpath  = /var/log/backend/access.log
# Ban after 60 matching requests within any 10-second window
maxretry = 60
findtime = 10s
